{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "project": ["*.js"]
    },
    "packages/build": {
      "project": ["src/**/*.js", "src/**/*.ts"],
      "ignoreDependencies": ["@lvce-editor/verror", "esbuild", "playwright"]
    },
    "packages/e2e": {
      "entry": ["src/**/*.ts"],
      "project": ["src/**/*.ts"],
      "ignoreDependencies": ["playwright-core"]
    },
    "packages/main-area-worker": {
      "entry": ["src/mainAreaWorkerMain.ts", "test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/server": {
      "project": ["src/**/*.js"]
    },
    "packages/e2e-integration": {
      "entry": ["src/**/*.{ts,js}", "scripts/*.mjs", "stage-cursor-tests.mjs"],
      "project": ["src/**/*.{ts,js}", "fixtures/*.js", "scripts/*.mjs", "stage-cursor-tests.mjs"],
      "ignoreDependencies": ["@lvce-editor/test-with-playwright"]
    }
  }
}
