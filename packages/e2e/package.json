{
  "name": "e2e",
  "version": "0.0.0-dev",
  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "e2e": "test-with-playwright --only-extension=. --test-path=. --browser=chromium --reuse-page --server-path=../server/src/dev.js",
    "e2e:firefox": "test-with-playwright --only-extension=. --test-path=. --browser=firefox --reuse-page --server-path=../server/src/dev.js",
    "e2e:firefox:headless": "test-with-playwright --only-extension=. --test-path=. --browser=firefox --headless --reuse-page --server-path=../server/src/dev.js",
    "e2e:headless": "test-with-playwright --only-extension=. --test-path=. --browser=chromium --headless --reuse-page --server-path=../server/src/dev.js",
    "e2e:webkit": "node ./scripts/run-webkit-e2e.js",
    "e2e:webkit:headless": "node ./scripts/run-webkit-e2e.js --headless",
    "type-check": "tsc"
  },
  "devDependencies": {
    "@lvce-editor/test-with-playwright": "^22.29.0",
    "playwright-core": "1.62.1"
  }
}
